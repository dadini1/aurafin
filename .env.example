# ============================================================
# AuraFin · Variables de entorno
# Copia este archivo a `.env` (local) o configúralo en Render.
# NUNCA commitees el archivo `.env` con valores reales.
# ============================================================

# --- Base de datos en la nube (Supabase, fuente de verdad) ---
# Proyecto → Settings → API → Project URL y service_role key.
# La service_role SOLO vive en el servidor; el anon key nunca se usa aquí.
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="TU_SERVICE_ROLE_KEY"

# --- Espejo local en disco (una carpeta por empresa) ---
# En Windows: G:\AURAFIN\data  ·  En Linux/Render: /var/data/aurafin
AURAFIN_DATA_DIR="G:\AURAFIN\data"
BACKUP_RETENTION=7

# --- Seguridad ---
# Secreto para firmar sesiones HMAC (genera uno único en producción):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AURAFIN_SESSION_SECRET=""
# Token heredado para clientes antiguos de /api/sync/state (opcional):
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AURAFIN_SYNC_TOKEN=""
# Bootstrap del primer superadmin (solo se crea si no existe ningún usuario):
AURAFIN_ADMIN_EMAIL="admin@aurafin.app"
AURAFIN_ADMIN_PASSWORD="AuraFin2026!"

# --- Servidor ---
PORT=3000
HOST=127.0.0.1          # para publicar en Render: 0.0.0.0
NODE_ENV=development    # production activa CSP y sirve dist/

# --- IA (opcional; el resto de la app funciona sin esto) ---
# https://aistudio.google.com/api-key — solo el servidor la usa
GEMINI_API_KEY=""

# --- App (enlace autorreferenciado) ---
APP_URL="https://TU-APP.onrender.com"
